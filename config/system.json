{
  "can": [
    {
      "interface": "virtual",
      "channel": "vcan0",
      "bitrate": 500000,
      "can_json_path": "config/can0.json",
      "can_db_files": ["db/candb/p_v2.dbc"]
    }
  ],
  "simulator": {
    "enabled": true,
    "random_mode": false,
    "default_cycle_ms": 10,
    "can_json_path": "config/can0.json"
  },
  "adaptive_restraint": {
    "db_path": "db/adaptive_restraint_db/synthetic_data_out_gui.db",
    "csv_path": "db/adaptive_restraint_db/synthetic_data_out_gui.csv"
  },
  "adap": {
    "enabled": true,
    "default_cycle_ms": 10,
    "can_json_path": "config/can0.json"
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8000,
    "api_key": "change-me-in-production",
    "ws_heartbeat_interval_sec": 0.5,
    "ws_metrics_interval_sec": 0.3,
    "cors_origins": [
      "http://localhost:8000",
      "http://localhost:5173"
    ]
  },
  "camera": {
    "enabled": true,
    "stream_url": "http://192.168.2.119:8080/stream",
    "reconnect_interval_sec": 3.0,
    "connect_timeout_sec": 5.0,
    "read_timeout_sec": 10.0,
    "chunk_size": 4096,
    "subscriber_queue_size": 64,
    "startup_wait_sec": 5.0,
    "fps_log_interval_sec": 5.0
  },
  "storage": {
    "engine": "sqlite",
    "sqlite_path": "data/signals.db",
    "batch_size": 100,
    "batch_interval_sec": 2.0,
    "retention_days": 30,
    "max_disk_mb": 2048
  },
  "processor": {
    "smoothing_window": 5,
    "max_update_rate_hz": 5000.0,
    "max_queue_size": 10000,
    "queue_policy": "drop_oldest",
    "batch_drain_size": 200
  },
  "alarms": {
    "enabled": false,
    "config_path": "config/alarms.json",
    "check_interval_sec": 0.5
  },
  "reader": {
    "frequency_piority": 1,
    "only_send_signal_update": true,
    "stale_threshold_sec": 30.0
  },
  "writer": {
    "rate_limit_per_sec": 10,
    "burst": 5,
    "periodic_mode": true,
    "periodic_time_step": 20,
    "periodic_duration": 10000
  },
  "shutdown": {
    "timeout_sec": 10
  },
  "supervisor": {
    "watchdog_interval_sec": 5
  },
  "signal": {
    "sync_dict": "config/signal_std_name.json"
  },
  "logging": {
    "level": "INFO",
    "file_path": "logs/can-hmi.log",
    "max_size_mb": 50,
    "backup_count": 5
  }
}