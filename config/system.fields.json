{
  "schema_version": 1,
  "fields": [
    {
      "path": "can",
      "title": "Can",
      "type": "array",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "CAN bus list; adding or removing a bus requires reboot.",
      "validation": {
        "items": {
          "type": "object"
        }
      },
      "ui": {
        "control": "json-textarea"
      }
    },
    {
      "path": "can.*.interface",
      "title": "Interface",
      "type": "string",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "Python-CAN interface.",
      "validation": {
        "enum": [
          "socketcan",
          "virtual",
          "pcan",
          "vector",
          "kvaser"
        ]
      },
      "ui": {
        "control": "select"
      }
    },
    {
      "path": "can.*.channel",
      "title": "Channel",
      "type": "string",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "Unique CAN channel name. Use 'auto' with a single SocketCAN channel to select an UP canX interface using channel_tracking_signals, or all DBC messages when that list is empty.",
      "examples": [
        "can0",
        "auto"
      ],
      "ui": {
        "control": "combobox",
        "options_source": "can_channels.options",
        "option_details_source": "can_channels.devices",
        "allow_custom": true
      }
    },
    {
      "path": "can.*.bitrate",
      "title": "Bitrate",
      "type": "integer",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "CAN bitrate.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "can.*.can_db_file",
      "title": "CAN database file",
      "type": "string",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "DBC file for this CAN channel.",
      "examples": [
        "db/can_db/Interface_Panther_To_CarPC_v8.dbc"
      ],
      "validation": {
        "allowed_extensions": [
          ".dbc"
        ],
        "must_exist": true,
        "must_parse_as": "dbc"
      },
      "ui": {
        "control": "file-path",
        "directory": "db/can_db",
        "accept": [
          ".dbc"
        ]
      }
    },
    {
      "path": "can.*.channel_tracking_signals",
      "title": "Channel tracking signals",
      "type": "array",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "For channel='auto', select an interface receiving any message containing a listed DBC signal. Empty means all DBC messages with signals. Normal reading still includes all signals.",
      "validation": {
        "items": {
          "type": "string"
        }
      },
      "ui": {
        "control": "json-textarea"
      }
    },
    {
      "path": "can.*.channel_tracking_signals.*",
      "title": "Tracking signal",
      "type": "string",
      "editable": true,
      "setting_mode": "expand",
      "reload_level": "reboot",
      "description": "DBC signal whose message can identify the automatic CAN channel.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "simulator.enabled",
      "title": "Enabled",
      "type": "boolean",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "Enable or disable the CAN simulator.",
      "ui": {
        "control": "checkbox"
      }
    },
    {
      "path": "simulator.random_mode",
      "title": "Random Mode",
      "type": "boolean",
      "editable": true,
      "setting_mode": "expand",
      "reload_level": "reboot",
      "description": "Simulator data generation mode.",
      "ui": {
        "control": "checkbox"
      }
    },
    {
      "path": "simulator.default_cycle_ms",
      "title": "Default Cycle Ms",
      "type": "integer",
      "editable": true,
      "setting_mode": "expand",
      "reload_level": "reboot",
      "description": "Simulator transmission cycle.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "simulator.can_db_file",
      "title": "CAN database file",
      "type": "string",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "DBC file used by the simulator.",
      "examples": [
        "db/can_db/Interface_Panther_To_CarPC_v8.dbc"
      ],
      "validation": {
        "allowed_extensions": [
          ".dbc"
        ],
        "must_exist": true,
        "must_parse_as": "dbc"
      },
      "ui": {
        "control": "file-path",
        "directory": "db/can_db",
        "accept": [
          ".dbc"
        ]
      }
    },
    {
      "path": "adaptive_restraint.db_path",
