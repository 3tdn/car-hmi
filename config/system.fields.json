        "control": "text"
      }
    },
    {
      "path": "storage.engine",
      "title": "Engine",
      "type": "string",
      "reload_level": "immutable",
      "description": "The storage engine cannot change at runtime.",
      "validation": {
        "enum": [
          "sqlite",
          "timescaledb",
          "influxdb"
        ]
      },
      "ui": {
        "control": "select"
      }
    },
    {
      "path": "storage.sqlite_path",
      "title": "Sqlite Path",
      "type": "string",
      "reload_level": "immutable",
      "description": "An open database cannot change at runtime.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "storage.batch_size",
      "title": "Batch Size",
      "type": "integer",
      "reload_level": "live",
      "description": "Pipeline batch flush threshold.",
