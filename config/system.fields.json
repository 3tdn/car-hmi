    {
      "path": "status_monitor.enabled",
      "title": "Enabled",
      "type": "boolean",
      "reload_level": "reboot",
      "description": "Status monitor task is created at startup.",
      "ui": {
        "control": "checkbox"
      }
    },
    {
      "path": "status_monitor.interval_sec",
      "title": "Interval Sec",
      "type": "number",
      "reload_level": "reboot",
      "description": "Status monitor interval.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "status_monitor.ping_timeout_sec",
      "title": "Ping Timeout Sec",
