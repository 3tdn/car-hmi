      "type": "integer",
      "editable": true,
      "setting_mode": "base",
      "reload_level": "reboot",
      "description": "API server bind port.",
      "validation": {
        "minimum": 1,
        "maximum": 65535
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "api.api_key",
