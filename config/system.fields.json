        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "camera.read_timeout_sec",
      "title": "Read Timeout Sec",
      "type": "number",
      "reload_level": "reboot",
      "description": "Camera read timeout.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "camera.chunk_size",
      "title": "Chunk Size",
      "type": "integer",
      "reload_level": "reboot",
