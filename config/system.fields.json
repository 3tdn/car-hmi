        "control": "password",
        "sensitive": true
      }
    },
    {
      "path": "api.ws_metrics_interval_sec",
      "title": "Ws Metrics Interval Sec",
      "type": "number",
      "editable": true,
      "setting_mode": "expand",
      "reload_level": "live",
