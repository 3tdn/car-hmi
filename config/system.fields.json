{
  "schema_version": 1,
  "fields": [
    {
      "path": "can",
      "title": "Can",
      "type": "array",
      "reload_level": "reboot",
      "description": "CAN bus list; adding or removing a bus requires reboot.",
      "validation": {
        "items": {
          "type": "object"
        }
      },
      "ui": {
        "control": "json-textarea"
      }
    },
    {
      "path": "can.*.interface",
      "title": "Interface",
      "type": "string",
      "reload_level": "reboot",
      "description": "Python-CAN interface.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "can.*.channel",
      "title": "Channel",
      "type": "string",
      "reload_level": "reboot",
      "description": "Unique CAN channel name.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "can.*.bitrate",
      "title": "Bitrate",
      "type": "integer",
      "reload_level": "reboot",
      "description": "CAN bitrate.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "can.*.can_db_file",
      "title": "CAN database file",
      "type": "string",
      "reload_level": "reboot",
      "description": "DBC file for this CAN channel.",
      "examples": [
        "db/can_db/Interface_Panther_To_CarPC_v8.dbc"
      ],
      "validation": {
        "allowed_extensions": [
          ".dbc"
        ],
        "must_exist": true,
        "must_parse_as": "dbc"
      },
      "ui": {
        "control": "file-path",
        "directory": "db/can_db",
        "accept": [
          ".dbc"
        ]
      }
    },
    {
      "path": "simulator.enabled",
      "title": "Enabled",
      "type": "boolean",
      "reload_level": "reboot",
      "description": "Enable or disable the CAN simulator.",
      "ui": {
        "control": "checkbox"
      }
    },
    {
      "path": "simulator.random_mode",
      "title": "Random Mode",
      "type": "boolean",
      "reload_level": "reboot",
      "description": "Simulator data generation mode.",
      "ui": {
        "control": "checkbox"
      }
    },
    {
      "path": "simulator.default_cycle_ms",
      "title": "Default Cycle Ms",
      "type": "integer",
      "reload_level": "reboot",
      "description": "Simulator transmission cycle.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "simulator.can_db_file",
      "title": "CAN database file",
      "type": "string",
      "reload_level": "reboot",
      "description": "DBC file used by the simulator.",
      "examples": [
        "db/can_db/Interface_Panther_To_CarPC_v8.dbc"
      ],
      "validation": {
        "allowed_extensions": [
          ".dbc"
        ],
        "must_exist": true,
        "must_parse_as": "dbc"
      },
      "ui": {
        "control": "file-path",
        "directory": "db/can_db",
        "accept": [
          ".dbc"
        ]
      }
    },
    {
      "path": "adaptive_restraint.db_path",
      "title": "Db Path",
      "type": "string",
      "reload_level": "immutable",
      "description": "Data path is fixed at application startup.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "adaptive_restraint.csv_path",
      "title": "Csv Path",
      "type": "string",
      "reload_level": "immutable",
      "description": "Data path is fixed at application startup.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "api.host",
      "title": "Host",
      "type": "string",
      "reload_level": "reboot",
      "description": "API server bind address.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "api.port",
      "title": "Port",
      "type": "integer",
      "reload_level": "reboot",
      "description": "API server bind port.",
      "validation": {
        "minimum": 1,
        "maximum": 65535
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "api.api_key",
      "title": "API key",
      "type": "string",
      "reload_level": "immutable",
      "description": "Authentication secrets cannot be changed through the config API.",
      "ui": {
        "control": "password",
        "sensitive": true
      }
    },
    {
      "path": "api.ws_heartbeat_interval_sec",
      "title": "Ws Heartbeat Interval Sec",
      "type": "number",
      "reload_level": "immutable",
      "description": "The current runtime does not use this heartbeat setting.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "api.ws_metrics_interval_sec",
      "title": "Ws Metrics Interval Sec",
      "type": "number",
      "reload_level": "live",
      "description": "System metrics broadcast interval.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "api.cors_origins",
      "title": "Cors Origins",
      "type": "array",
      "reload_level": "reboot",
      "description": "CORS middleware is created at startup.",
      "validation": {
        "items": {
          "type": "string"
        }
      },
      "ui": {
        "control": "json-textarea"
      }
    },
    {
      "path": "api.cors_origins.*",
      "title": "*",
      "type": "string",
      "reload_level": "reboot",
      "description": "An allowed CORS origin.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "profiles.profiles_path",
      "title": "Profiles Path",
      "type": "string",
      "reload_level": "immutable",
      "description": "The profile path cannot be changed through the runtime API.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "profiles.sessions_path",
      "title": "Sessions Path",
      "type": "string",
      "reload_level": "immutable",
      "description": "The session path cannot be changed through the runtime API.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "profiles.allow_legacy_profile_mutations",
      "title": "Allow Legacy Profile Mutations",
      "type": "boolean",
      "reload_level": "immutable",
      "description": "Legacy profile mutations are not implemented by the current runtime.",
      "ui": {
        "control": "checkbox"
      }
    },
    {
      "path": "profiles.default_profile_permission",
      "title": "Default Profile Permission",
      "type": "array",
      "reload_level": "reboot",
      "description": "Default profile permissions.",
      "validation": {
        "items": {
          "type": "string"
        }
      },
      "ui": {
        "control": "json-textarea"
      }
    },
    {
      "path": "profiles.default_profile_permission.*",
      "title": "*",
      "type": "string",
      "reload_level": "reboot",
      "description": "A default profile permission.",
      "ui": {
        "control": "text"
      }
    },
    {
      "path": "profiles.session_online_ttl_seconds",
      "title": "Session Online Ttl Seconds",
      "type": "integer",
      "reload_level": "reboot",
      "description": "Profile session TTL.",
      "validation": {
        "minimum": 1
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "profiles.session_history_limit",
      "title": "Session History Limit",
      "type": "integer",
      "reload_level": "reboot",
      "description": "Profile session history limit.",
      "validation": {
        "minimum": 1
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "profiles.session_cleanup_interval_sec",
      "title": "Session Cleanup Interval Sec",
      "type": "number",
      "reload_level": "reboot",
      "description": "Profile session cleanup interval.",
      "validation": {
        "exclusiveMinimum": 0
      },
      "ui": {
        "control": "number"
      }
    },
    {
      "path": "camera.enabled",
      "title": "Enabled",
      "type": "boolean",
      "reload_level": "reboot",
      "description": "Camera proxy is created at startup.",
