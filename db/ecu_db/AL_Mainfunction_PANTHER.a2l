              OS_ResetSourceSW_2
              OS_ResetSourceSW_3
              OS_ResetSourceSW_4
              OS_ResetSourceSW_5
           /end REF_MEASUREMENT
        /end GROUP

	  

        /begin MOD_PAR "Memory layout and access"            
          VERSION  "panther"
          SUPPLIER "adcos GmbH"
          CUSTOMER ""
          ECU      "PANTHER"
          CPU_TYPE "ARM Cortex-M7"
          
          /begin MEMORY_SEGMENT  BootloaderCode "Bootloader Code"
            /* program type */ CODE
            /* memory type  */ FLASH
            /* attribute    */ INTERN
            /* address      */ 0x08000000
            /* size         */ 0x00020000  
            /* offset       */ -1 -1 -1 -1 -1
            /begin IF_DATA XCP
              /begin SEGMENT
                /* segment number     */ 0x00
                /* number of pages    */ 0x00
                /* address extension  */ 0x00
                /* compression method */ 0x00
                /* encryption method  */ 0x00
              /end SEGMENT
            /end IF_DATA
          /end MEMORY_SEGMENT
          
          /begin MEMORY_SEGMENT  AppCode "Application Code"
            /* program type */ CODE
            /* memory type  */ FLASH
            /* attribute    */ INTERN
            /* address      */ 0x08020000
            /* size         */ 0x00065580
            /* offset       */ -1 -1 -1 -1 -1
            /begin IF_DATA XCP
              /begin SEGMENT
                /* segment number     */ 0x01
                /* number of pages    */ 0x00
                /* address extension  */ 0x00
                /* compression method */ 0x00
                /* encryption method  */ 0x00
              /end SEGMENT
            /end IF_DATA
          /end MEMORY_SEGMENT

          /begin MEMORY_SEGMENT  AppCodeEndSequence "AppCodeEndSequence"
              /* program type */ CODE
              /* memory type  */ FLASH
              /* attribute    */ INTERN
              /* address      */ 0x081DFFE0
              /* size         */ 0x00000020
              /* offset       */ -1 -1 -1 -1 -1
              /begin IF_DATA XCP
                /begin SEGMENT
                  /* segment number     */ 0x02
                  /* number of pages    */ 0x00
                  /* address extension  */ 0x00
                  /* compression method */ 0x00
                  /* encryption method  */ 0x00
                /end SEGMENT
            /end IF_DATA
        /end MEMORY_SEGMENT
          
          /begin MEMORY_SEGMENT  DataROM "DataROM"
            /* program type */ DATA
            /* memory type  */ FLASH
            /* attribute    */ INTERN
            /* address      */ 0x08020300
            /* size         */ 0x000174c0
            /* offset       */ -1 -1 -1 -1 -1
            /begin IF_DATA XCP
              /begin SEGMENT
                /* segment number     */ 0x03
                /* number of pages    */ 0x00
                /* address extension  */ 0x00
                /* compression method */ 0x00
                /* encryption method  */ 0x00
                /begin ADDRESS_MAPPING
                  /* address        */ 0x08020300
                  /* mapped address */ 0x24000000
                  /* size           */ 0x000174c0
                /end ADDRESS_MAPPING
              /end SEGMENT
            /end IF_DATA
          /end MEMORY_SEGMENT
          
          /begin MEMORY_SEGMENT  DataRAM "DataRAM"
            /* program type */ DATA
            /* memory type  */ RAM
            /* attribute    */ INTERN
            /* address      */ 0x24000000
            /* size         */ 0x0002b198
            /* offset       */ -1 -1 -1 -1 -1
            /begin IF_DATA XCP
              /begin SEGMENT
                /* segment number     */ 0x04
                /* number of pages    */ 0x01
                /* address extension  */ 0x00
                /* compression method */ 0x00
                /* encryption method  */ 0x00
                /begin PAGE
                  /* page number */ 0x00
                  ECU_ACCESS_DONT_CARE
                  XCP_READ_ACCESS_DONT_CARE
                  XCP_WRITE_ACCESS_DONT_CARE
                  /* segment that initialises this page: */
                  INIT_SEGMENT 0x03
                /end PAGE
              /end SEGMENT
            /end IF_DATA
          /end MEMORY_SEGMENT
      
        /end MOD_PAR 

        /begin MOD_COMMON
            ""
            ALIGNMENT_BYTE 1
            ALIGNMENT_WORD 2
            ALIGNMENT_LONG 4
            ALIGNMENT_FLOAT32_IEEE 4
            ALIGNMENT_FLOAT64_IEEE 8
            BYTE_ORDER MSB_LAST
            DEPOSIT ABSOLUTE
        /end MOD_COMMON 

            /begin IF_DATA XCP
                /begin PROTOCOL_LAYER
                    0x0100	/* Driver_Version */
                    0x07D0	/* Timeout1 */
                    0x00C8	/* Timeout2 */
                    0x0000	/* Timeout3 */
                    0x0000	/* Timeout4 */
                    0x0000	/* Timeout5 */
                    0x0000	/* Timeout6 */
                    0x0000	/* Timeout7 */
                    0xFF	/* XCP_MAX_CTO */
                    0x00FF	/* XCP_MAX_DTO */
                    BYTE_ORDER_MSB_LAST	/* XCP_BYTE_ORDER */
                    ADDRESS_GRANULARITY_BYTE	/* ADDRESS_GRANULARITY */
                    OPTIONAL_CMD SET_MTA	/* OptionalCMD_SET_MTA */
                    OPTIONAL_CMD UPLOAD	/* OptionalCMD_UPLOAD */
                    OPTIONAL_CMD SHORT_UPLOAD	/* OptionalCMD_SHORT_UPLOAD */
                    OPTIONAL_CMD DOWNLOAD	/* OptionalCMD_DOWNLOAD */
                    OPTIONAL_CMD ALLOC_ODT_ENTRY	/* OptionalCMD_ALLOC_ODT_ENTRY */
                    OPTIONAL_CMD ALLOC_ODT	/* OptionalCMD_ALLOC_ODT */
