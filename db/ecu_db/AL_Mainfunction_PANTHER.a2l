              OS_BswVersion
              OS_RtiVersion
              OS_BootloaderVersion
              OS_FpgaVersion
              OS_Status
              OS_AppConfig
              OS_CpuTemp
              OS_TaskTime1
              OS_RunTime1
              OS_RunTimeMax1
              OS_RunTimeMin1
              OS_TaskLoad1
              OS_Overrun1
           /end REF_MEASUREMENT
        /end GROUP

