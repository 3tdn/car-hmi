           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      255
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402af09
           FORMAT                            "%10.0"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_ResetSourceHW_6
           /* Long identifier        */      "OS Reset Source Hardware 6"
           /* Data type              */      UBYTE
           /* Conversion method      */      CM_OS_ResetSourceHW.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      255
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402af08
           FORMAT                            "%10.0"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_ResetSourceHW_7
           /* Long identifier        */      "OS Reset Source Hardware 7"
           /* Data type              */      UBYTE
           /* Conversion method      */      CM_OS_ResetSourceHW.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      255
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402aef8
           FORMAT                            "%10.0"
        /end MEASUREMENT

        /begin COMPU_METHOD
           /* Name of CompuMethod    */      CM_OS_CpuTemp.CONVERSION
           /* Long identifier        */      "Conversion method for CPU temperature"
           /* Conversion Type        */      RAT_FUNC
           /* Format                 */      "%3.0"
           /* Units                  */      "degC" /* °C */
           /* Coefficients           */      COEFFS 0 1 0 0 0 1
        /end COMPU_METHOD

        /begin MEASUREMENT
           /* Name                   */      OS_CpuTemp
           /* Long identifier        */      "Temperature of the CPU"
           /* Data type              */      SBYTE
           /* Conversion method      */      CM_OS_CpuTemp.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      -128
           /* Upper limit            */      127
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402af54
           FORMAT                            "%10.0"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_TaskLoad1
           /* Long identifier        */      "OS variable to monitor cpu load for task 1"
           /* Data type              */      FLOAT32_IEEE
           /* Conversion method      */      OS_TaskLoad.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      100
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402af88
           FORMAT                            "%3.2"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_Overrun1
           /* Long identifier        */      "OS variable to monitor application overruns for task 1"
           /* Data type              */      UBYTE
           /* Conversion method      */      NO_COMPU_METHOD
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      1
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402afb0
           FORMAT                            "%1.0"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_RunTime1
           /* Long identifier        */      "OS variable to monitor actual application runtime for task 1"
           /* Data type              */      FLOAT32_IEEE
           /* Conversion method      */      OS_Time.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      1
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402afcc
           FORMAT                            "%2.0"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_RunTimeMax1
           /* Long identifier        */      "OS variable to display maximal application runtime for task 1"
           /* Data type              */      FLOAT32_IEEE
           /* Conversion method      */      OS_Time.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      1
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402af38
           FORMAT                            "%2.0"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_RunTimeMin1
           /* Long identifier        */      "OS variable to display minimum application runtime for task 1"
           /* Data type              */      FLOAT32_IEEE
           /* Conversion method      */      OS_Time.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      1
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402afc4
           FORMAT                            "%2.0"
        /end MEASUREMENT

        /begin MEASUREMENT
           /* Name                   */      OS_TaskTime1
           /* Long identifier        */      "OS variable to display application sample time for task 1"
           /* Data type              */      FLOAT32_IEEE
           /* Conversion method      */      OS_Time.CONVERSION
           /* Resolution (Not used)  */      0
           /* Accuracy (Not used)    */      0
           /* Lower limit            */      0
           /* Upper limit            */      1
           BYTE_ORDER                        MSB_LAST
           ECU_ADDRESS                       0x2402af20
           FORMAT                            "%2.0"
        /end MEASUREMENT
        
        /begin GROUP OS "Variables to display Operating System (OS) information"
           ROOT
           /begin SUB_GROUP
              OS_Reset
           /end SUB_GROUP
