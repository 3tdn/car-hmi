        /begin CHARACTERISTIC
            PARAM_VS_BRK_BRK_ax_filter	/* Name */
            "Gain for low pass filtering of the longitudinal accelearation:\n\nLow Pass Filter: y_k = y_k + e*(y_k-1 + y_k)\nSMA_fapp_BRK_ax_filter can be set in a range of 0 to 255.\nThen the effective gain e is calculated in a range of 0.745 to 1.\n\nSo the time constant of the filter is greater with higher values of SMA_fapp_BRK_ax_filter.\nWhen set to 255 the filter output is constant zero."	/* LongIdentifier */
            VALUE	/* Type */
            0x24016114	/* Address */
            UBYTE_COL_DIRECT	/* Deposit */
            0	/* MaxDiff */
            NO_COMPU_METHOD	/* Conversion */
            0	/* LowerLimit */
            255	/* UpperLimit */
            BYTE_ORDER MSB_LAST
            SYMBOL_LINK "PARAM_VS_BRK_BRK_ax_filter" 0
        /end CHARACTERISTIC

