                    OPTIONAL_CMD START_STOP_DAQ_LIST	/* OptionalCMD_START_STOP_DAQ_LIST */
                    OPTIONAL_CMD GET_DAQ_LIST_MODE	/* OptionalCMD_GET_DAQ_LIST_MODE */
                    OPTIONAL_CMD SET_DAQ_LIST_MODE	/* OptionalCMD_SET_DAQ_LIST_MODE */
                    OPTIONAL_CMD WRITE_DAQ	/* OptionalCMD_WRITE_DAQ */
                    OPTIONAL_CMD SET_DAQ_PTR	/* OptionalCMD_SET_DAQ_PTR */
                    OPTIONAL_CMD GET_COMM_MODE_INFO	/* OptionalCMD_GET_COMM_MODE_INFO */
                /end PROTOCOL_LAYER
                /begin DAQ
