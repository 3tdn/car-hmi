VERSION "Mercedes-Benz Common Signals v1.0"

// -----------------------------------------------------------------------------
// DBC File Structure (Mercedes-Benz Common Signals)
//
// - VERSION: file version/name.
// - NS_: naming section (defines which keyword lists are enabled).
// - BS_: bit timing section (often empty in many exports).
// - BU_: node (ECU) list.
// - BO_: message definition (ID, name, DLC, sender node).
// - SG_: signal definition within a message (start bit, length, byte order,
//         factor, offset, min/max, unit, receivers).
// - CM_: comments (for messages/signals/nodes).
// - VAL_: value descriptions (enumerations for signal values).
// - BA_: attribute values / metadata.
//
// Add comments using CM_ lines, e.g.:
//    CM_ BO_ 608 "Engine status message";
// -----------------------------------------------------------------------------

NS_ :
	NS_DESC_
	CM_
	BA_DEF_
	BA_
	VAL_
	CAT_DEF_
	CAT_
	FILTER
	BA_DEF_DEF_
	EV_DATA_
	ENVVAR_DATA_
	SGTYPE_
	SGTYPE_VAL_
	BA_DEF_SGTYPE_
	BA_SGTYPE_
	SIG_GROUP_
	SIG_VALTYPE_
	SIGTYPE_VALTYPE_

BS_:

BU_: ECM TCM ESP IC BCM ADAS SRS HVAC EPB EPS


// =============================================================================
// POWERTRAIN - Động cơ & Truyền động
// =============================================================================

// --- ECM: Engine Control Module (Bộ điều khiển động cơ) ---
