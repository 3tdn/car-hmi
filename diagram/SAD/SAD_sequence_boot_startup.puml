@startuml SAD_sequence_boot_startup
!theme plain
title System Startup — Software Architecture
hide footbox

actor "Admin / CLI" as admin
participant "Configuration" as config
participant "AppRunner" as runner
participant "Store / Metadata" as store
participant "Signal Pipeline" as pipeline
participant "CAN Layer" as can
participant "Audio Playback" as audio
participant "API / WebSocket" as api

admin -> config : Load system.json and validate configuration
config --> admin : AppConfig
admin -> runner : Start configured runtime
runner -> runner : Reserve API endpoint; register signal handlers
runner -> can : Load each channel's DBC
runner -> store : Seed signal values and replace metadata catalog
runner -> pipeline : Construct shared queue and processing stages
runner -> can : Open buses; construct readers, writers, and writer router
runner -> audio : Construct AudioManager(config.audio, store, writer router)
runner -> audio : Start audio manager
audio -> store : Subscribe to HMI_Soundfile; publish idle state
audio -> can : Attempt idle feedback: position=-1, active=0 (twice)
opt Simulator enabled and all channels virtual
    runner -> can : Construct simulator
end
runner -> api : Build API server and connect WebSocket to SignalStore
runner -> runner : Launch pipeline, readers, optional simulator, API,\nmetrics, and configured monitoring tasks
runner --> admin : Runtime started

note over audio, api
  Audio subscribes before API startup and before reader tasks begin.
  Playback starts only after a changed, valid HMI_Soundfile request.
end note
@enduml
