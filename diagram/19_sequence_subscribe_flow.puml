@startuml 19_sequence_subscribe_flow
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title Sequence Diagram — Subscribe-based Data Streaming

actor       "Frontend
(Browser)"  as FE
participant "FastAPI
REST"        as REST
participant "ConnectionManager
(websocket.py)" as WS
participant "SignalStore"          as SS
participant "SystemMetrics
(runner)"  as SM

== Phase 1: Initial Metadata Fetch (One-Time, Heavy) ==

FE -> REST : GET /signals/available
REST -> SS : get_snapshot()
REST -> REST : merge signals.json
+ alarms.json
REST --> FE : 200 SignalMetadataListResponse
(unit, min, max, widget, alarm
thresholds, value, status, timestamp)

note right of FE
  Frontend caches metadata locally.
  Knows structure of all signals without
  subsequent heavy requests.
end note

== Phase 2: Open Subscribe WebSocket ==

FE -> WS : WS /ws/subscribe
WS --> FE : accept (handshake)

FE -> WS : {"action":"subscribe",
"channels":["EngineSpeed","BatterySOC",
"alarms","metrics"],
"mode":"continuous"}
WS -> WS : acquire _lock
mutate subscription state
WS --> FE : {"type":"subscribe_ack", ...}

note right of WS
  ConnectionManager acquires asyncio.Lock
  before mutating _ClientSubscription state
  to prevent race with broadcast task.
  - signal_names: {"EngineSpeed","BatterySOC"}
  - subscribe_alarms: true
  - subscribe_metrics: true
end note

== Phase 3: Lightweight Value Streaming ==

SS -> WS : signal update
("EngineSpeed", 2750.0, 1719800001.5)
WS -> WS : filter: client subscribed
to "EngineSpeed"? YES
WS --> FE : {"type":"signal",
"signal":"EngineSpeed",
"value":2750.0,
"timestamp":1719800001.5}

note right of FE
  Frontend updates the widget using
  cached metadata (unit=rpm, min=0, max=8000)
  → receives only value + timestamp (lightweight)
end note

SS -> WS : signal update
("SteeringAngle", -5.0, ...)
WS -> WS : filter: client subscribed
to "SteeringAngle"? NO
WS ->x WS : skip — not sent

== Phase 4: Alarm Push ==

WS --> FE : {"type":"alarm",
"signal_name":"BatterySOC",
"level":"warning", ...}

== Phase 5: Metrics Push ==

SM -> WS : broadcast_metrics({...})
WS --> FE : {"type":"metrics",
"cpu_percent":23.4,
"ram_percent":41.0, ...}

== Phase 6: Dynamic Subscribe/Unsubscribe ==

FE -> WS : {"action":"subscribe",
"channels":["WheelSpeed_FL"],
"mode":"continuous"}
WS --> FE : subscribe_ack

FE -> WS : {"action":"unsubscribe",
"channels":["BatterySOC"]}
WS --> FE : subscribe_ack

note right of FE
  The client can change the channel list
  at any time → the server updates the filter
  → reduces bandwidth flexibly.
end note

== Phase 7: One-Shot Mode ==

FE -> WS : {"action":"subscribe",
"channels":["EngineTemp"],
"mode":"once"}
WS --> FE : subscribe_ack
SS -> WS : signal update ("EngineTemp", 85.3, ...)
WS --> FE : {"type":"signal","signal":"EngineTemp","value":85.3, ...}
WS -> WS : auto-unsubscribe
"EngineTemp" (once mode)

@enduml
