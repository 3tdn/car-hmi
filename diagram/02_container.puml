@startuml Container Diagram
!theme plain
title CAN-HMI System — Container Diagram (C4 Level 2)

skinparam rectangle {
    RoundCorner 15
}

actor "Driver / Engineer" as user

rectangle "Vehicle Side" as vehicle #lightyellow {
    rectangle "CAN Simulator\n[Python: python-can]\n(dev mode, virtual bus)" as sim #wheat
}

database "CAN Database\n[config/can0.json, can1.json]\nPer-channel signal definitions" as candb #Wheat

rectangle "CarPC (Onboard Compute)" as carpc #LightBlue {
    rectangle "CAN I/O\n[python-can]\nMulti-channel async reader + writer" as canio #PaleGreen
    rectangle "Signal Processor\n[Pipeline pattern]\nSmoothing, rate-limit, computed, alarm" as proc #PaleGreen
    rectangle "Signal Store\n[In-memory dict]\nLatest values + Observer callbacks" as store #PaleGreen
    rectangle "Storage\n[aiosqlite / SQLite]\nTime-series + alarm + config" as db #Wheat
    rectangle "FastAPI Backend\n[FastAPI + uvicorn]\nREST API + WebSocket\n(/ws/subscribe per-signal)" as api #PaleGreen
    rectangle "System Metrics\n[psutil]\n/system/metrics, /health, /ready" as mon #LightGray
}

rectangle "Frontend" as fe #LightPink {
    rectangle "Web Dashboard\n[HTML + CSS + JS]\nGauge, chart, table, alarm\n(Mode: Dev / User)" as dash #MistyRose
}

sim <-right-> canio : "CAN frames\n(virtual bus, dev mode only)"
canio -down-> proc : "asyncio.Queue\n(decoded signals)"
proc -right-> store : "publish updates\n(Observer pattern)"
proc -down-> db : "batch insert\n(signal_log, alarm_log)"
store --> api : "latest values\n(snapshot)"
db --> api : "history query\n(SQL)"
api -right-> dash : "REST + WebSocket\n(JSON stream)"
dash -left-> api : "PUT signals, PATCH config,\nGET export\n(write-back)"
api -up-> canio : "encode + send\n(CANWriterRouter)"
mon -right-> api : "/system/health, /ready, /metrics"
user -down-> dash : "Browser\nHTTP/WS"
candb -right-> canio : "load at startup\n(message/signal defs)"
candb -right-> sim : "encode frames\n(signal→CAN)"

@enduml
