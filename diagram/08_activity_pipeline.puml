@startuml Activity - Signal Processing Pipeline
!theme plain
title Signal Processing Pipeline — Activity Diagram

start

:Receive DecodedFrame\nfrom asyncio.Queue;

if (Queue full?\n(size >= max_queue_size)) then (yes)
    if (queue_policy?) then (drop_oldest)
        :Drop oldest frame;
        :Keep the newest frame;
    else (reject)
        :Reject the new frame;
        stop
    endif
endif

:Drain up to batch_drain_size frames;
:Coalesce each signal to its newest value;

partition "Stage 1: Rate Limiter" {
    :Check last update timestamp\nfor each signal;
    if (Δt < 1/max_update_rate_hz?) then (yes)
        :Skip this update;
    else (no)
        :Allow update;
    endif
}

partition "Stage 2: Computed Signals" {
    :Calculate configured derived values;
    :Add results to signal dictionary;
}

if (any exception during stages?) then (yes)
    :Log error;
    :Drop batch and continue;
    stop
endif

:Bulk update SignalStore\n(in-memory latest values);
:Notify WebSocket subscribers;

note right
  Realtime samples remain in memory.
end note

stop

@enduml
