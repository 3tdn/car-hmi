@startuml Sequence - Signal Read Flow
!theme plain
title Signal Read Flow — CAN Bus → Dashboard

actor "Vehicle ECU\n(Simulator)" as ecu
participant "CAN Bus\n(vcan0 / vcan1)" as bus
participant "CAN recv thread" as recv_thread
participant "AppRunner\n(runner.py)" as runner
participant "DatabaseLoader\n(parser.py)" as parser
participant "CAN Reader[i]\n(reader.py)" as reader
queue "asyncio.Queue\n(shared, all channels)" as q
participant "Signal Processor\n(pipeline.py)" as proc
participant "Signal Store\n(signal_store.py)" as store
database "SQLite\n(signal_log)" as db
participant "WebSocket\n(websocket.py)" as ws
actor "Dashboard\n(Browser)" as dash

== Startup (per CAN channel) ==
note over runner
  AppRunner loads per-channel DatabaseLoader and
  creates one CANReader per channel (passes db_loader)
end note
reader -> bus : connect(interface, channel, bitrate)
activate reader
reader -> reader : DatabaseLoader.load(can_json_path)
note right of reader : Queue policy: drop_oldest | reject

== Continuous Read Loop ==
loop every CAN frame
    ecu -> bus : CAN frame (ID, data)
    bus -> recv_thread : recv() (blocking in recv thread)
    recv_thread -> reader : call_soon_threadsafe(enqueue DecodedFrame)
    activate reader
    reader -> reader : decode using db_loader.decode_frame(msg_id, data)
    reader -> q : put(DecodedFrame)
end

== Signal Processing (batch_drain_size frames at a time) ==
loop consume from queue
    q -> proc : get batch up to batch_drain_size
    note right of proc : Merge same signal_id→keep latest value
    proc -> proc : 1. SmoothingFilter.process()
    proc -> proc : 2. RateLimiter.process()
    proc -> proc : 3. ComputedSignals.process()
    proc -> proc : 4. AlarmChecker.process()
    
    proc -> store : update(signal_name, value, status)
    activate store
    store -> ws : notify subscribers
    deactivate store
    
    proc -> db : buffer.append(record)
    alt batch_size reached OR batch_interval_sec elapsed
        proc -> db : INSERT INTO signal_log\n(batch insert)
    end

    alt alarm triggered (value exceeds threshold)
        proc -> proc : call alarm_handler (AppRunner._on_alarm)
        proc -> db : INSERT INTO alarm_log
        proc -> ws : broadcast_alarm(alarm_payload)
        ws -> dash : {"type":"alarm",\n "signal_name":"CoolantTemp","level":"warning"}
    end
end

== WebSocket Push ==
ws -> dash : {"type":"signal",\n "signal":"VehicleSpeed","value":85.3,"timestamp":...}

note over ecu, dash
  NFR: End-to-end latency CAN → WebSocket ≤ 100 ms (P95)
  Throughput ≥ 1000 signals/s sustained
end note

@enduml
