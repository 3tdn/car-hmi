@startuml SDD_sequence_boot_startup
!theme plain
title System Startup — Component Initialization and Audio Lifecycle
hide footbox

participant "CLI / main()" as cli
participant "Configuration" as config
participant "AppRunner" as runner
participant "DatabaseLoader" as parser
participant "SignalStore / Metadata" as store
participant "SignalPipeline" as pipeline
participant "CAN Layer" as can
participant "AudioManager" as audio
participant "FastAPI / WebSocket" as api

cli -> config : load_config(path); apply_environment_overrides()
config --> cli : Validated AppConfig
cli -> runner : AppRunner(cfg); start()
runner -> runner : _setup_logging(); reserve API socket\nregister SIGINT / SIGTERM handlers

group _init_components(loop)
    loop Each configured CAN channel
        runner -> parser : DatabaseLoader(); load_dbc(can_db_file)
        parser --> runner : Shared per-channel loader
    end
    runner -> store : bulk_update(initial values, units)\nreplace_from_loaders(db_loaders)
    runner -> pipeline : Construct queue and SignalPipeline
    runner -> pipeline : Add RateLimiter, HBStateNormalizer,\nOMSClassificationProcessor, ComputedSignals
    runner -> runner : Disable simulator if any channel uses real hardware
    loop Each configured CAN channel
        runner -> can : create_bus(channel config)
        note right of can : Failed connection remains recoverable; API startup continues.
        runner -> can : Construct CANWriter and CANReader\nregister writer in CANWriterRouter
    end

    runner -> audio : AudioManager(config.audio, store, can_writer=router)
    runner -> audio : await start()
    audio -> store : subscribe(_on_signal_update)\nbulk_update(position=-1, active=0)
    loop Two idle response attempts
        audio -> can : send_signals_batch_once({HMI_AudioTimesamp:-1,\nHMI_ActiveSoundfile:0})
    end
    opt Simulator enabled after hardware check
        runner -> can : _build_simulator(sim_cfg)
    end
    runner -> api : _build_api_server(): create_app(...)
    api -> store : Register WebSocket broadcast subscriber
    api --> runner : Uvicorn server coroutine

    runner -> runner : Schedule pipeline, per-channel readers, optional\nsimulator, API, watchdog, metrics-push, and status monitor
end

runner --> cli : System running; await runtime tasks
note over runner, audio
  AudioManager is started before API construction and reader tasks.
  audio.enabled=false rejects playback requests; the manager still publishes idle state.
  Position/completion tasks are created per playback, not at startup.
end note
@enduml
