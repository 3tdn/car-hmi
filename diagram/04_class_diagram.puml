' ─── Signal Processing (Pipeline Pattern) ───
package "processor" as pkg_proc #LightCyan {
abstract class ProcessingStage <<ABC>> {
    +{abstract} process(signals: dict[str, float]): dict[str, float]
}

class SmoothingFilter extends ProcessingStage {
    -_window: int
    -_method: str
    -_buffers: dict[str, deque]
    +process(signals: dict): dict
}

class RateLimiter extends ProcessingStage {
    -_min_interval: float
    -_last_update: dict[str, float]
    +process(signals: dict): dict
}

class AlarmChecker extends ProcessingStage {
    -_configs: dict[str, AlarmConfig]
    -_state: dict[str, str]
    -_handlers: list[Callable]
    +add_alarm_handler(handler: Callable): void
    +process(signals: dict): dict
    -_eval_state(cfg: AlarmConfig, value: float): tuple | None
}

class ComputedSignals extends ProcessingStage {
    -_formulas: dict[str, Callable]
    +add_formula(name: str, fn: Callable): void
    +process(signals: dict): dict
}
}

