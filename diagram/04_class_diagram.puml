' ─── Storage (Repository Pattern) ───
package "storage" as pkg_storage #Wheat {
abstract class ISignalRepository <<ABC>> {
    +{abstract} insert_batch(records: list[SignalRecord]): void
    +{abstract} get_history(name: str, start: float, end: float, limit: int): list[SignalRecord]
    +{abstract} insert_alarm(alarm: Alarm): int
    +{abstract} get_alarms(limit: int, offset: int, active_only: bool): list[AlarmRecord]
    +{abstract} get_alarm_by_id(alarm_id: int): AlarmRecord | None
    +{abstract} acknowledge_alarm(alarm_id: int): bool
    +{abstract} resolve_alarm(alarm_id: int): bool
    +{abstract} get_signal_config(name: str): SignalConfigRecord | None
    +{abstract} upsert_signal_config(cfg: SignalConfigRecord): void
    +{abstract} list_signal_configs(): list[SignalConfigRecord]
    +{abstract} purge_old(days: int): int
    +{abstract} close(): void
}

class SQLiteRepository implements ISignalRepository {
    -_db_path: str
    -_conn: aiosqlite.Connection | None
    +open(): void
    +close(): void
    +insert_batch(records): void
    +get_history(name, start, end, limit): list[SignalRecord]
    +insert_alarm(alarm): int
    +get_alarms(limit, offset, active_only): list[AlarmRecord]
    +get_alarm_by_id(alarm_id): AlarmRecord | None
    +acknowledge_alarm(alarm_id): bool
    +resolve_alarm(alarm_id): bool
    +get_signal_config(name): SignalConfigRecord | None
    +upsert_signal_config(cfg): void
    +list_signal_configs(): list[SignalConfigRecord]
    +purge_old(days): int
}

class DataExporter {
    -_repo: ISignalRepository
    +export_signals_csv(path: str, start: float, end: float): int
    +export_alarms_json(path: str, start: float, end: float): int
}

