@startuml Database ER Diagram
!theme plain
title CAN-HMI System — Signal Configuration Database

entity "signal_config" as config {
    *signal_name : TEXT <<PK>>
    --
    unit : TEXT
    min_value : REAL
    max_value : REAL
    group_name : TEXT
    widget_type : TEXT
    writable : BOOLEAN <<DEFAULT 0>>
    *updated_at : REAL <<NOT NULL>>
}

note right of config
    data/config.db contains only
    persistent display metadata.
    Realtime signal values remain
    in the in-memory SignalStore.
end note

@enduml
