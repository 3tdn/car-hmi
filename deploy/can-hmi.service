[Unit]
Description=CAN-HMI Signal Dashboard
Documentation=https://github.com/3tdn/car-hmi
After=network.target can.target

[Service]
Type=simple
User=@@SERVICE_USER@@
WorkingDirectory=@@PROJECT_DIR@@
ExecStart=@@PROJECT_DIR@@/.venv/bin/can-hmi --config @@PROJECT_DIR@@/config/system.json
Restart=on-failure
RestartSec=5
# WatchdogSec=30

# Environment
Environment=CAN_HMI_LOG_LEVEL=INFO
EnvironmentFile=-@@PROJECT_DIR@@/.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=false
ReadWritePaths=@@PROJECT_DIR@@/data @@PROJECT_DIR@@/logs
PrivateTmp=true

# Resource limits
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
